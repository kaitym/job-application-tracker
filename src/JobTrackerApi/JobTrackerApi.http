@JobTrackerApi_HostAddress = http://localhost:5181

### List all jobs
GET {{JobTrackerApi_HostAddress}}/jobs
Accept: application/json

### Add a job
POST {{JobTrackerApi_HostAddress}}/jobs
Content-Type: application/json

{
  "company": "Toshiba",
  "role": "Software Engineer",
  "location": "Irvine, CA",
  "status": "Applied",
  "dateApplied": "2026-11-10",
  "deadline": "2026-12-01"
}

### Get one job
GET {{JobTrackerApi_HostAddress}}/jobs/1
Accept: application/json

### Update a job
PUT {{JobTrackerApi_HostAddress}}/jobs/1
Content-Type: application/json

{
  "company": "Toshiba",
  "role": "Software Engineer",
  "location": "Irvine, CA",
  "status": "Interviewing",
  "dateApplied": "2026-11-10",
  "notes": "Phone screen Friday",
  "needsAction": true
}

### Delete a job
DELETE {{JobTrackerApi_HostAddress}}/jobs/1

### Filter and search jobs
GET {{JobTrackerApi_HostAddress}}/jobs?status=Applied&search=irvine
Accept: application/json

### Jobs where they responded (Order up!)
GET {{JobTrackerApi_HostAddress}}/jobs?needsAction=true
Accept: application/json

### A job's status history
GET {{JobTrackerApi_HostAddress}}/jobs/1/history
Accept: application/json

### Applied jobs with no news in 30 days
GET {{JobTrackerApi_HostAddress}}/jobs/gone-cold?days=30
Accept: application/json

### Schedule an interview
POST {{JobTrackerApi_HostAddress}}/jobs/1/interviews
Content-Type: application/json

{
  "scheduledAt": "2026-12-02T10:00:00-08:00",
  "kind": "Phone screen",
  "notes": "Bring questions about the team"
}

### A job's interviews
GET {{JobTrackerApi_HostAddress}}/jobs/1/interviews
Accept: application/json

### Interviews in the next 14 days
GET {{JobTrackerApi_HostAddress}}/interviews/upcoming?days=14
Accept: application/json

### Stats, XP, and shop level
GET {{JobTrackerApi_HostAddress}}/stats
Accept: application/json

###
